    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "husky": "^9.1.4",
    "lint-staged": "^17.5.1"
  }
}
